#version 450 core

/**
 * Kerma Radiation Oncology Simulation Engine
 * GPU Class II Condensed History Electron Transport Compute Shader
 *
 * Implements:
 * - Continuous Slowing Down Approximation (CSDA) with restricted stopping power
 * - Highland multiple Coulomb scattering distribution over condensed step s
 * - Step hinge transport with spatial curvature correction
 * - Local track-length energy deposition into 3D voxel dose grid
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ElectronState {
    vec3  pos_mm;
    vec3  dir;
    float kinetic_energy_mev;
    float weight;
    int   alive;
    uint  rng_state;
};

layout(std430, binding = 0) buffer ElectronBatchBuffer {
    ElectronState electrons[];
};

// 3D medium properties (R = mass density g/cm3, G = rho_e, B = Z_eff)
layout(binding = 1, rgba32f) readonly uniform image3D u_density_volume;

// 3D accumulated dose volume in Gray
layout(binding = 2, r32f) uniform image3D u_dose_volume;

layout(std140, binding = 3) uniform ElectronTransportConfig {
    vec3  grid_origin_mm;
    vec3  voxel_spacing_mm;
    ivec4 volume_dimensions;
    float max_fractional_energy_loss; // e.g. 0.05 (5% loss per step)
    float cutoff_energy_mev;          // e.g. 0.020 MeV (20 keV)
    float radiation_length_water_mm;  // 360.8 mm
    float dose_weight_scale;
};

uint lcg_random(inout uint state) {
    state = state * 1664525u + 1013904223u;
    return state;
}

float rand_float(inout uint state) {
    return float(lcg_random(state)) * (1.0f / 4294967296.0f);
}

// Restricted collision stopping power in MeV / mm for water-equivalent medium
float evaluate_stopping_power(float t_mev, float rho_e) {
    // Bethe-Bloch parameterized approximation for electrons in water
    // dE/dx ~ 2.0 MeV/(g/cm2) in minimum ionizing region, rising at low energies
    float beta2 = 1.0f - 1.0f / pow(1.0f + t_mev / 0.51099895f, 2.0f);
    beta2 = max(beta2, 1e-4f);
    float dedx_mass = (0.1535f / beta2) * (log(max(t_mev * 1000.0f, 1.0f)) + 8.5f); // MeV cm2/g
    float dedx_linear = dedx_mass * 0.1f * rho_e; // Convert cm^-1 to mm^-1
    return max(dedx_linear, 0.01f);
}

// Sample Gaussian multiple Coulomb scattering angle theta from Highland formula
float sample_highland_angle(float t_mev, float step_mm, float x0_mm, inout uint rng) {
    float p_mev_c = sqrt(t_mev * (t_mev + 2.0f * 0.51099895f));
    float beta = p_mev_c / (t_mev + 0.51099895f);
    float l_over_x0 = max(step_mm / x0_mm, 1e-6f);
    
    // Highland standard deviation in radians
    float theta_0 = (13.6f / (beta * p_mev_c)) * sqrt(l_over_x0) * (1.0f + 0.038f * log(l_over_x0));
    
    // Box-Muller transform for Gaussian polar angle
    float u1 = max(rand_float(rng), 1e-7f);
    float u2 = rand_float(rng);
    float r = sqrt(-2.0f * log(u1));
    return theta_0 * r * cos(2.0f * 3.14159265f * u2);
}

void build_orthonormal_frame(vec3 w, out vec3 u, out vec3 v) {
    if (abs(w.z) < 0.999f) {
        u = normalize(cross(w, vec3(0.0f, 0.0f, 1.0f)));
    } else {
        u = normalize(cross(w, vec3(1.0f, 0.0f, 0.0f)));
    }
    v = cross(w, u);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= electrons.length()) {
        return;
    }

    if (electrons[idx].alive == 0) {
        return;
    }

    float t_mev = electrons[idx].kinetic_energy_mev;
    if (t_mev <= cutoff_energy_mev) {
        electrons[idx].alive = 0;
        return;
    }

    vec3 pos = electrons[idx].pos_mm;
    vec3 dir = electrons[idx].dir;
    uint rng = electrons[idx].rng_state;

    vec3 voxel_f = (pos - grid_origin_mm) / voxel_spacing_mm;
    ivec3 voxel_coord = ivec3(floor(voxel_f));

    if (any(lessThan(voxel_coord, ivec3(0))) || any(greaterThanEqual(voxel_coord, volume_dimensions.xyz))) {
        electrons[idx].alive = 0;
        return;
    }

    vec4 med = imageLoad(u_density_volume, voxel_coord);
    float rho_e = max(med.g, 0.001f);
    float x0_local_mm = radiation_length_water_mm / max(med.r, 0.001f);

    // Compute stopping power and maximum step length
    float dedx = evaluate_stopping_power(t_mev, rho_e);
    float delta_t_max = t_mev * max_fractional_energy_loss;
    float step_length_mm = delta_t_max / dedx;

    // Clamp step length to voxel dimension to preserve boundary accuracy
    float min_voxel_dim = min(voxel_spacing_mm.x, min(voxel_spacing_mm.y, voxel_spacing_mm.z));
    step_length_mm = min(step_length_mm, 0.5f * min_voxel_dim);

    float energy_loss_mev = min(step_length_mm * dedx, t_mev);

    // Deposit energy at midpoint (step hinge)
    vec3 hinge_pos = pos + 0.5f * step_length_mm * dir;
    vec3 hinge_vox = (hinge_pos - grid_origin_mm) / voxel_spacing_mm;
    ivec3 hinge_coord = ivec3(floor(hinge_vox));

    if (all(greaterThanEqual(hinge_coord, ivec3(0))) && all(lessThan(hinge_coord, volume_dimensions.xyz))) {
        float deposited_dose = energy_loss_mev * electrons[idx].weight * dose_weight_scale;
        float cur = imageLoad(u_dose_volume, hinge_coord).r;
        imageStore(u_dose_volume, hinge_coord, vec4(cur + deposited_dose, 0.0f, 0.0f, 0.0f));
    }

    // Multiple Coulomb scattering at hinge
    float theta = sample_highland_angle(t_mev - 0.5f * energy_loss_mev, step_length_mm, x0_local_mm, rng);
    float phi = 2.0f * 3.14159265358979323846f * rand_float(rng);

    vec3 u, v;
    build_orthonormal_frame(dir, u, v);
    vec3 new_dir = normalize(sin(theta) * (cos(phi) * u + sin(phi) * v) + cos(theta) * dir);

    // Update electron state
    electrons[idx].pos_mm = pos + step_length_mm * new_dir;
    electrons[idx].dir = new_dir;
    electrons[idx].kinetic_energy_mev = t_mev - energy_loss_mev;
    electrons[idx].rng_state = rng;

    if (electrons[idx].kinetic_energy_mev <= cutoff_energy_mev) {
        electrons[idx].alive = 0;
    }
}
