#version 450 core

/**
 * Kerma Radiation Oncology Simulation Engine
 * GPU Monte Carlo Klein-Nishina Compton Scatter Solver
 *
 * Implements exact relativistic Compton scattering kinematics:
 * - Kahn's rejection sampling algorithm for differential cross-section d(sigma)/d(Omega)
 * - Azimuthal polarization rotation and direction deflection
 * - Recoil electron energy deposition T = E - E' into the 3D dose grid
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ParticlePhoton {
    vec3  pos_mm;
    vec3  dir;
    float energy_mev;
    float weight;
    int   alive;
    uint  rng_state;
};

layout(std430, binding = 0) buffer PhotonBatchBuffer {
    ParticlePhoton photons[];
};

// 3D accumulated dose volume in Gray
layout(binding = 1, r32f) uniform image3D u_dose_volume;

layout(std140, binding = 2) uniform ComptonConfig {
    vec3  grid_origin_mm;
    vec3  voxel_spacing_mm;
    ivec4 volume_dimensions;
    float electron_mass_mev; // 0.51099895 MeV
    float cutoff_energy_mev; // 0.010 MeV
    float dose_weight_scale; // Scale factor for Gy per particle
};

uint lcg_random(inout uint state) {
    state = state * 1664525u + 1013904223u;
    return state;
}

float rand_float(inout uint state) {
    return float(lcg_random(state)) * (1.0f / 4294967296.0f);
}

// Construct an orthonormal coordinate system (u, v, w) from primary direction w
void build_orthonormal_frame(vec3 w, out vec3 u, out vec3 v) {
    if (abs(w.z) < 0.999f) {
        u = normalize(cross(w, vec3(0.0f, 0.0f, 1.0f)));
    } else {
        u = normalize(cross(w, vec3(1.0f, 0.0f, 0.0f)));
    }
    v = cross(w, u);
}

// Sample scattered photon energy and cosine of scattering angle via Kahn's algorithm
void sample_kahn_klein_nishina(float e_in, inout uint rng, out float e_out, out float cos_theta) {
    float alpha = e_in / electron_mass_mev;
    float alpha2 = 2.0f * alpha;

    for (int iter = 0; iter < 100; ++iter) {
        float r1 = rand_float(rng);
        float r2 = rand_float(rng);
        float r3 = rand_float(rng);

        float eta;
        if (r1 <= (1.0f + alpha2) / (9.0f + alpha2)) {
            eta = 1.0f + alpha2 * r2;
            if (r3 <= 4.0f * (eta - 1.0f) / (alpha2 * eta)) {
                cos_theta = 1.0f - (eta - 1.0f) / alpha;
                e_out = e_in / eta;
                return;
            }
        } else {
            eta = (1.0f + alpha2) / (1.0f + alpha2 * r2);
            cos_theta = 1.0f - (eta - 1.0f) / alpha;
            float sin2_theta = max(1.0f - cos_theta * cos_theta, 0.0f);
            if (r3 <= 0.5f * (1.0f + (1.0f / (eta * eta)) - sin2_theta / eta)) {
                e_out = e_in / eta;
                return;
            }
        }
    }

    // Fallback: Thomson forward scatter approximation
    cos_theta = 1.0f;
    e_out = e_in;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= photons.length()) {
        return;
    }

    if (photons[idx].alive == 0) {
        return;
    }

    float e_in = photons[idx].energy_mev;
    if (e_in < cutoff_energy_mev) {
        photons[idx].alive = 0;
        return;
    }

    uint rng = photons[idx].rng_state;
    float e_out;
    float cos_theta;
    sample_kahn_klein_nishina(e_in, rng, e_out, cos_theta);

    // Azimuthal angle uniform over [0, 2*pi)
    float phi = 2.0f * 3.14159265358979323846f * rand_float(rng);
    float sin_theta = sqrt(max(1.0f - cos_theta * cos_theta, 0.0f));

    // Scatter direction in local spherical frame
    vec3 local_dir = vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);

    // Transform direction to laboratory reference frame
    vec3 u, v;
    build_orthonormal_frame(photons[idx].dir, u, v);
    vec3 new_dir = normalize(local_dir.x * u + local_dir.y * v + local_dir.z * photons[idx].dir);

    // Calculate recoil electron kinetic energy
    float recoil_energy_mev = e_in - e_out;

    // Deposit recoil electron energy locally into 3D voxel grid
    vec3 voxel_f = (photons[idx].pos_mm - grid_origin_mm) / voxel_spacing_mm;
    ivec3 voxel_coord = ivec3(floor(voxel_f));

    if (recoil_energy_mev > 0.0f &&
        all(greaterThanEqual(voxel_coord, ivec3(0))) &&
        all(lessThan(voxel_coord, volume_dimensions.xyz))) {
        
        float deposited_dose = recoil_energy_mev * photons[idx].weight * dose_weight_scale;
        float cur = imageLoad(u_dose_volume, voxel_coord).r;
        imageStore(u_dose_volume, voxel_coord, vec4(cur + deposited_dose, 0.0f, 0.0f, 0.0f));
    }

    // Update outgoing photon state
    photons[idx].energy_mev = e_out;
    photons[idx].dir = new_dir;
    photons[idx].rng_state = rng;

    if (e_out < cutoff_energy_mev) {
        photons[idx].alive = 0;
    }
}
