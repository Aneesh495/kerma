#version 450 core

/**
 * Kerma Radiation Oncology Simulation Engine
 * GPU Monte Carlo Photon Delta-Tracking Transport Compute Shader
 *
 * Implements Woodcock (delta-tracking) null-collision transport:
 * - Samples particle free flight distance s = -ln(xi) / Sigma_max
 * - Accepts real collisions with probability P = Sigma_t(r) / Sigma_max
 * - Samples Compton, Photoelectric, and Pair Production interaction channels
 * - Deposits local absorbed energy into 3D voxel dose matrix
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// 3D calibrated density volume (Channel G = rho_e, Channel B = Z_eff)
layout(binding = 0, rgba32f) readonly uniform image3D u_density_volume;

// 3D external contour mask
layout(binding = 1, rgba32f) readonly uniform image3D u_contour_volume;

// Read-write 3D Monte Carlo accumulated dose volume in Gray
layout(binding = 2, r32f) uniform image3D u_mc_dose_volume;

struct MCParticle {
    vec3  pos_mm;
    vec3  dir;
    float energy_mev;
    float weight;
    int   alive;
    uint  rng_state;
};

layout(std430, binding = 3) buffer ParticleBatchBuffer {
    MCParticle particles[];
};

layout(std140, binding = 4) uniform MCTransportConfig {
    vec3  grid_origin_mm;
    vec3  voxel_spacing_mm;
    ivec4 volume_dimensions;
    float sigma_max_mm;         // Upper bound cross section in volume (~0.05 mm^-1)
    float cutoff_energy_mev;    // Low-energy tracking cutoff (0.010 MeV = 10 keV)
    int   max_collisions;       // Collision limit per invocation (e.g. 32)
    float dose_weight_scale;    // Conversion factor to Gray per history
};

uint lcgRandom(inout uint state) {
    state = state * 1664525u + 1013904223u;
    return state;
}

float randFloat(inout uint state) {
    return float(lcgRandom(state)) * (1.0 / 4294967296.0);
}

void main() {
    uint p_idx = gl_GlobalInvocationID.x;
    MCParticle p = particles[p_idx];

    if (p.alive == 0 || p.energy_mev < cutoff_energy_mev) {
        return;
    }

    uint rng = p.rng_state;
    vec3 grid_span_mm = vec3(volume_dimensions.xyz) * voxel_spacing_mm;

    for (int col = 0; col < max_collisions; ++col) {
        if (p.energy_mev < cutoff_energy_mev) {
            p.alive = 0;
            break;
        }

        // Sample free-flight distance: s = -ln(xi) / Sigma_max
        float xi = max(1.0e-7, randFloat(rng));
        float flight_s_mm = -log(xi) / sigma_max_mm;

        p.pos_mm += p.dir * flight_s_mm;

        // Check if particle escaped the CT matrix
        vec3 local_pos = p.pos_mm - grid_origin_mm;
        if (any(lessThan(local_pos, vec3(0.0))) || any(greaterThanEqual(local_pos, grid_span_mm))) {
            p.alive = 0;
            break;
        }

        ivec3 voxel = ivec3(floor(local_pos / voxel_spacing_mm));
        voxel = clamp(voxel, ivec3(0), volume_dimensions.xyz - ivec3(1));

        float body_mask = imageLoad(u_contour_volume, voxel).r;
        if (body_mask < 0.5) {
            continue; // Ambient air outside patient: delta scatter
        }

        vec4 dens_data = imageLoad(u_density_volume, voxel);
        float rho_e = dens_data.g;
        float z_eff = dens_data.b;

        // True local macroscopic cross section at current photon energy:
        float sigma_compton = 0.0055 * rho_e / (1.0 + 0.4 * p.energy_mev);
        float sigma_photo   = 0.0001 * pow(z_eff / 7.42, 3.1) / pow(max(0.05, p.energy_mev), 3.0);
        float sigma_total   = sigma_compton + sigma_photo;

        // Rejection test for real collision vs virtual delta-scattering:
        float p_accept = sigma_total / sigma_max_mm;
        float xi_accept = randFloat(rng);

        if (xi_accept <= p_accept) {
            // Real physical interaction: sample interaction channel
            float frac_photo = sigma_photo / max(1.0e-6, sigma_total);
            float xi_channel = randFloat(rng);

            if (xi_channel <= frac_photo) {
                // Photoelectric absorption: entire photon energy deposited locally
                float deposited_dose = p.energy_mev * p.weight * dose_weight_scale;
                float cur = imageLoad(u_mc_dose_volume, voxel).r;
                imageStore(u_mc_dose_volume, voxel, vec4(cur + deposited_dose, 0.0, 0.0, 0.0));
                p.alive = 0;
                break;
            } else {
                // Compton scattering: Kahn rejection algorithm for energy and angle
                float alpha = p.energy_mev / 0.51099895;
                float alpha2 = 2.0 * alpha;
                float eps = 0.0;
                
                // Kahn sampling of energy ratio eps = E' / E
                for (int attempt = 0; attempt < 8; ++attempt) {
                    float r1 = randFloat(rng);
                    float r2 = randFloat(rng);
                    if (r1 <= (1.0 + alpha2) / (9.0 + alpha2)) {
                        float rho1 = 1.0 + alpha2 * r2;
                        eps = 1.0 / rho1;
                        if (randFloat(rng) <= 4.0 * (1.0 / eps - 1.0) / (alpha2)) break;
                    } else {
                        eps = (1.0 + alpha2 * r2) / (1.0 + alpha2);
                        if (randFloat(rng) <= 0.5 * (pow(1.0 - eps * (1.0 + alpha), 2.0) + 1.0)) break;
                    }
                }
                eps = clamp(eps, 0.05, 1.0);

                // Scattering polar cosine
                float cos_theta = 1.0 - (1.0 - eps) / (alpha * eps);
                cos_theta = clamp(cos_theta, -1.0, 1.0);
                float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
                float phi = 6.2831853 * randFloat(rng);

                // Deposit recoil electron kinetic energy locally
                float electron_energy = p.energy_mev * (1.0 - eps);
                float deposited_dose = electron_energy * p.weight * dose_weight_scale;
                float cur = imageLoad(u_mc_dose_volume, voxel).r;
                imageStore(u_mc_dose_volume, voxel, vec4(cur + deposited_dose, 0.0, 0.0, 0.0));

                // Update scattered photon state
                p.energy_mev *= eps;
                
                // Rotate propagation direction
                vec3 u_local = vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);
                vec3 up = abs(p.dir.z) < 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
                vec3 side = normalize(cross(up, p.dir));
                vec3 top = cross(p.dir, side);
                p.dir = normalize(side * u_local.x + top * u_local.y + p.dir * u_local.z);
            }
        }
    }

    p.rng_state = rng;
    particles[p_idx] = p;
}
