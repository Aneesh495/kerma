#version 450 core

/**
 * Kerma Radiation Oncology Simulation Engine
 * GPU Monte Carlo Photoelectric Absorption and Atomic Relaxation Shader
 *
 * Implements:
 * - K-shell, L-shell, and valence shell photoelectric absorption
 * - Photoelectron kinetic energy evaluation T = h*nu - B_shell
 * - Atomic de-excitation cascade: characteristic fluorescent X-ray vs Auger electron
 * - Local kinetic energy deposition into 3D voxel dose grid
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ParticlePhoton {
    vec3  pos_mm;
    vec3  dir;
    float energy_mev;
    float weight;
    int   alive;
    uint  rng_state;
};

layout(std430, binding = 0) buffer PhotonBatchBuffer {
    ParticlePhoton photons[];
};

// 3D medium properties (R = mass density g/cm3, G = rho_e, B = Z_eff)
layout(binding = 1, rgba32f) readonly uniform image3D u_density_volume;

// 3D accumulated dose volume in Gray
layout(binding = 2, r32f) uniform image3D u_dose_volume;

layout(std140, binding = 3) uniform PhotoelectricConfig {
    vec3  grid_origin_mm;
    vec3  voxel_spacing_mm;
    ivec4 volume_dimensions;
    float cutoff_energy_mev; // Minimum tracking threshold (e.g. 0.001 MeV = 1 keV)
    float dose_weight_scale; // Dose conversion factor
};

uint lcg_random(inout uint state) {
    state = state * 1664525u + 1013904223u;
    return state;
}

float rand_float(inout uint state) {
    return float(lcg_random(state)) * (1.0f / 4294967296.0f);
}

// Compute K-shell binding energy in MeV from effective atomic number Z
float get_k_shell_binding_energy_mev(float z) {
    // Moseley's Law approximation: E_K = 13.6 eV * (Z - 1)^2 converted to MeV
    float z_minus_1 = max(z - 1.0f, 1.0f);
    return 13.6e-6f * z_minus_1 * z_minus_1;
}

// Compute K-shell fluorescence yield omega_k (Bambynek et al. empirical fit)
float get_fluorescence_yield(float z) {
    float z4 = pow(z, 4.0f);
    const float a_const = 1.0e6f;
    return z4 / (a_const + z4);
}

void sample_isotropic_direction(inout uint rng, out vec3 dir) {
    float u = rand_float(rng) * 2.0f - 1.0f; // cos(theta)
    float phi = 2.0f * 3.14159265358979323846f * rand_float(rng);
    float s = sqrt(max(1.0f - u * u, 0.0f));
    dir = vec3(s * cos(phi), s * sin(phi), u);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= photons.length()) {
        return;
    }

    if (photons[idx].alive == 0) {
        return;
    }

    vec3 pos = photons[idx].pos_mm;
    vec3 voxel_f = (pos - grid_origin_mm) / voxel_spacing_mm;
    ivec3 voxel_coord = ivec3(floor(voxel_f));

    if (any(lessThan(voxel_coord, ivec3(0))) || any(greaterThanEqual(voxel_coord, volume_dimensions.xyz))) {
        photons[idx].alive = 0;
        return;
    }

    vec4 medium_props = imageLoad(u_density_volume, voxel_coord);
    float z_eff = max(medium_props.b, 1.0f);
    float e_in = photons[idx].energy_mev;
    uint rng = photons[idx].rng_state;

    float e_k = get_k_shell_binding_energy_mev(z_eff);
    float local_absorbed_energy_mev = 0.0f;

    if (e_in >= e_k) {
        // K-shell photoelectric absorption occurs
        // Primary photoelectron kinetic energy
        float t_photoelectron = e_in - e_k;
        local_absorbed_energy_mev += t_photoelectron;

        // Fluorescence vs Auger relaxation competition
        float omega_k = get_fluorescence_yield(z_eff);
        float r_relax = rand_float(rng);

        if (r_relax < omega_k && e_k > cutoff_energy_mev) {
            // Characteristic fluorescent X-ray emitted isotropically
            vec3 fluor_dir;
            sample_isotropic_direction(rng, fluor_dir);
            photons[idx].dir = fluor_dir;
            photons[idx].energy_mev = e_k;
            // Photon continues transport as characteristic secondary
        } else {
            // Auger electron emission: non-radiative transition, energy absorbed locally
            local_absorbed_energy_mev += e_k;
            photons[idx].alive = 0;
        }
    } else {
        // Outer shell photoelectric absorption: binding energy negligible, all energy absorbed
        local_absorbed_energy_mev += e_in;
        photons[idx].alive = 0;
    }

    // Deposit accumulated absorbed dose locally
    if (local_absorbed_energy_mev > 0.0f) {
        float deposited_dose = local_absorbed_energy_mev * photons[idx].weight * dose_weight_scale;
        float cur = imageLoad(u_dose_volume, voxel_coord).r;
        imageStore(u_dose_volume, voxel_coord, vec4(cur + deposited_dose, 0.0f, 0.0f, 0.0f));
    }

    photons[idx].rng_state = rng;
}
