#version 450 core

/**
 * Kerma Radiation Oncology Simulation Engine
 * GPU Monte Carlo Bethe-Heitler Pair and Triplet Production Shader
 *
 * Implements:
 * - High-energy photon pair production in nuclear and electron Coulomb fields
 * - Bethe-Heitler differential cross-section with Thomas-Fermi screening
 * - Electron and positron energy partition x = (T_+ + m_e c^2) / h*nu
 * - Characteristic opening angle theta ~ m_e c^2 / E
 * - Positron thermalization and 511 keV back-to-back annihilation quanta generation
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ParticlePhoton {
    vec3  pos_mm;
    vec3  dir;
    float energy_mev;
    float weight;
    int   alive;
    uint  rng_state;
};

layout(std430, binding = 0) buffer PhotonBatchBuffer {
    ParticlePhoton photons[];
};

// 3D medium properties (R = mass density g/cm3, G = rho_e, B = Z_eff)
layout(binding = 1, rgba32f) readonly uniform image3D u_density_volume;

// 3D accumulated dose volume in Gray
layout(binding = 2, r32f) uniform image3D u_dose_volume;

layout(std140, binding = 3) uniform PairConfig {
    vec3  grid_origin_mm;
    vec3  voxel_spacing_mm;
    ivec4 volume_dimensions;
    float electron_mass_mev; // 0.51099895 MeV
    float threshold_mev;     // 1.0219979 MeV
    float dose_weight_scale; // Dose conversion factor
};

uint lcg_random(inout uint state) {
    state = state * 1664525u + 1013904223u;
    return state;
}

float rand_float(inout uint state) {
    return float(lcg_random(state)) * (1.0f / 4294967296.0f);
}

// Sample polar opening angle from modified Tsai distribution
float sample_opening_angle(float energy_mev, inout uint rng) {
    float theta_0 = electron_mass_mev / max(energy_mev, 1.022f);
    float u = rand_float(rng);
    // Angular distribution peaked around theta_0
    return theta_0 * sqrt(u / max(1.0f - u, 1e-4f));
}

// Bethe-Heitler energy fraction sampling for x in [eps, 1 - eps]
float sample_energy_fraction(float energy_mev, inout uint rng) {
    float eps = electron_mass_mev / energy_mev;
    float delta_eps = 1.0f - 2.0f * eps;
    if (delta_eps <= 0.0f) {
        return 0.5f;
    }

    // Rejection sampling against symmetric Bethe-Heitler distribution
    // P(x) ~ x^2 + (1-x)^2 + (2/3)*x*(1-x)
    for (int iter = 0; iter < 50; ++iter) {
        float x = eps + delta_eps * rand_float(rng);
        float p = x * x + (1.0f - x) * (1.0f - x) + (2.0f / 3.0f) * x * (1.0f - x);
        float r = rand_float(rng);
        if (r <= p) {
            return x;
        }
    }
    return 0.5f;
}

void build_orthonormal_frame(vec3 w, out vec3 u, out vec3 v) {
    if (abs(w.z) < 0.999f) {
        u = normalize(cross(w, vec3(0.0f, 0.0f, 1.0f)));
    } else {
        u = normalize(cross(w, vec3(1.0f, 0.0f, 0.0f)));
    }
    v = cross(w, u);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= photons.length()) {
        return;
    }

    if (photons[idx].alive == 0) {
        return;
    }

    float e_in = photons[idx].energy_mev;
    if (e_in < threshold_mev) {
        // Below pair production threshold
        return;
    }

    vec3 pos = photons[idx].pos_mm;
    vec3 voxel_f = (pos - grid_origin_mm) / voxel_spacing_mm;
    ivec3 voxel_coord = ivec3(floor(voxel_f));

    if (any(lessThan(voxel_coord, ivec3(0))) || any(greaterThanEqual(voxel_coord, volume_dimensions.xyz))) {
        photons[idx].alive = 0;
        return;
    }

    uint rng = photons[idx].rng_state;

    // Sample fraction of energy carried by positron
    float frac_e = sample_energy_fraction(e_in, rng);
    float e_pair_total = e_in - 2.0f * electron_mass_mev;

    float t_electron = e_pair_total * (1.0f - frac_e);
    float t_positron = e_pair_total * frac_e;

    // In local radiotherapy simulation (under CSDA / charged particle equilibrium),
    // electron and positron kinetic energies deposit locally
    float local_absorbed_energy_mev = t_electron + t_positron;

    // Deposit dose into voxel
    if (local_absorbed_energy_mev > 0.0f) {
        float deposited_dose = local_absorbed_energy_mev * photons[idx].weight * dose_weight_scale;
        float cur = imageLoad(u_dose_volume, voxel_coord).r;
        imageStore(u_dose_volume, voxel_coord, vec4(cur + deposited_dose, 0.0f, 0.0f, 0.0f));
    }

    // Positron annihilates at rest producing two 511 keV photons
    // Transform photon[idx] into one of the annihilation quanta
    float theta_ann = sample_opening_angle(e_in, rng);
    float phi_ann = 2.0f * 3.14159265358979323846f * rand_float(rng);

    vec3 u, v;
    build_orthonormal_frame(photons[idx].dir, u, v);
    vec3 ann_dir = normalize(sin(theta_ann) * (cos(phi_ann) * u + sin(phi_ann) * v) + cos(theta_ann) * photons[idx].dir);

    photons[idx].energy_mev = electron_mass_mev; // 0.511 MeV
    photons[idx].dir = ann_dir;
    photons[idx].rng_state = rng;
}
