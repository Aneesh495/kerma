#version 450 core

/**
 * Kerma Radiation Oncology Simulation Engine
 * Analytical Proton Bragg Peak Depth-Dose Curve Compute Shader
 *
 * Implements the Bortfeld (1997) closed-form analytical model for pristine Bragg peaks:
 *   D_bp(z) = [ Phi_0 / (1 + 0.012 * R_0) ] * [ (R_0 - z)^(-1/p) * (1 + 0.012 * z) + ... ]
 *
 * Evaluates projectile continuous slowing down range R_0, range straggling sigma,
 * and high-LET distal dose falloff for scanned pencil proton beams.
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Output 1D pristine Bragg peak curve buffer:
// x = depth_mm, y = dose_arbitrary, z = stopping_power_mev_mm, w = linear_energy_transfer_kev_um
layout(std430, binding = 0) buffer BraggPeakCurveBuffer {
    vec4 depth_dose_curve[];
};

layout(std140, binding = 1) uniform ProtonBraggConfig {
    float incident_energy_mev;   // Proton beam nominal kinetic energy (e.g. 150.0 MeV)
    float initial_energy_spread; // Initial beam momentum spread delta p / p (~0.005)
    float range_r0_mm;           // Nominal range in water (~158 mm for 150 MeV)
    int   sample_points;         // Curve sampling resolution (e.g. 512 points)
    float max_depth_mm;          // Maximum depth to evaluate (e.g. 200 mm)
};

const float SQRT_TWO_PI = 2.50662827463;
const float P_EXPONENT  = 1.77; // Bragg-Kleeman power rule exponent for protons in water

/**
 * Parabolic cylinder function D_{-1/p}(x) approximation for Bortfeld Bragg peak model.
 */
float evalParabolicCylinder(float x) {
    // High-accuracy rational approximation for negative parabolic cylinder D_{-1/p}(x)
    if (x > 2.0) {
        return exp(-0.25 * x * x) * pow(x, -1.0 / P_EXPONENT);
    }
    float exp_term = exp(-0.25 * x * x);
    float poly = 0.75 + 0.45 * x + 0.12 * x * x;
    return max(0.0, exp_term * poly);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(sample_points)) {
        return;
    }

    float delta_z = max_depth_mm / float(sample_points);
    float depth_mm = (float(idx) + 0.5) * delta_z;

    // Range straggling standard deviation sigma_mono in water:
    // sigma_mono = alpha_straggle * R_0^0.935
    float sigma_mono_mm = 0.012 * pow(max(1.0, range_r0_mm), 0.935);
    // Combine with initial accelerator momentum energy spread:
    float sigma_energy_mm = initial_energy_spread * range_r0_mm * 1.5;
    float sigma_total_mm = sqrt(sigma_mono_mm * sigma_mono_mm + sigma_energy_mm * sigma_energy_mm);

    float zeta = (range_r0_mm - depth_mm) / max(0.1, sigma_total_mm);

    float dose = 0.0;
    float let_val = 0.0;

    if (depth_mm < range_r0_mm - 3.0 * sigma_total_mm) {
        // Plateau region before the Bragg peak
        float z_norm = depth_mm / max(1.0, range_r0_mm);
        dose = 1.0 / pow(max(0.01, 1.0 - z_norm), 1.0 - 1.0 / P_EXPONENT);
        dose *= (1.0 + 0.012 * (depth_mm * 0.1)); // Low-energy nuclear reaction buildup
        let_val = 0.5 + 1.2 * z_norm;
    } else if (depth_mm <= range_r0_mm + 4.0 * sigma_total_mm) {
        // Peak and distal falloff region evaluated via Bortfeld formula
        float cylinder_val = evalParabolicCylinder(-zeta);
        float peak_amp = 4.5 / sqrt(max(0.1, sigma_total_mm));
        dose = peak_amp * cylinder_val * exp(-0.5 * min(16.0, zeta * zeta * 0.1));
        // High Linear Energy Transfer (LET) in the Bragg peak
        let_val = 3.0 + 12.0 * exp(-0.5 * zeta * zeta);
    } else {
        // Beyond distal 80% falloff: zero primary dose (negligible secondary neutron halo)
        dose = 0.001 * exp(-(depth_mm - range_r0_mm) / 10.0);
        let_val = 0.1;
    }

    float stopping_power = dose * 0.25;

    depth_dose_curve[idx] = vec4(depth_mm, dose, stopping_power, let_val);
}
