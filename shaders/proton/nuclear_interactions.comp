#version 450 core

/**
 * Kerma Radiation Oncology Simulation Engine
 * GPU Proton Non-Elastic Nuclear Interaction and Halo Dose Shader
 *
 * Implements:
 * - Primary proton fluence attenuation along water-equivalent depth
 * - Non-elastic nuclear reaction cross-section (p + 16O, p + 12C)
 * - Double-Gaussian lateral nuclear halo kernel modeling wide-angle secondary protons and neutrons
 * - Track-averaged and dose-averaged Linear Energy Transfer (LET_d) enhancement estimation
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

// 3D Electromagnetic (core) proton pencil beam dose (Gy)
layout(binding = 0, r32f) readonly uniform image3D u_core_proton_dose;

// 3D medium relative stopping power ratio (SPR) volume
layout(binding = 1, r32f) readonly uniform image3D u_spr_volume;

// Output 3D combined physical + nuclear halo dose and LET_d (R = Total Dose Gy, G = Nuclear Halo Gy, B = LET_d keV/um)
layout(binding = 2, rgba32f) writeonly uniform image3D u_nuclear_dose_output;

layout(std140, binding = 3) uniform NuclearConfig {
    vec3  grid_origin_mm;
    vec3  voxel_spacing_mm;
    ivec4 volume_dimensions;
    vec3  beam_origin_mm;
    vec3  beam_axis_dir;
    float nominal_range_mm;
    float nuclear_loss_per_cm;     // ~0.012 cm^-1 (approx 1.2% per cm in water)
    float halo_fraction_weight;    // Energy fraction transferred to nuclear secondaries (~0.10 to 0.18)
    float halo_sigma_scale_mm;     // Characteristic wide lateral halo width (~10 to 25 mm)
};

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(coord, volume_dimensions.xyz))) {
        return;
    }

    vec3 voxel_pos = grid_origin_mm + (vec3(coord) + 0.5f) * voxel_spacing_mm;
    vec3 rel_pos = voxel_pos - beam_origin_mm;

    float depth_mm = dot(rel_pos, beam_axis_dir);
    if (depth_mm < 0.0f) {
        imageStore(u_nuclear_dose_output, coord, vec4(0.0f));
        return;
    }

    vec3 lateral_vec = rel_pos - depth_mm * beam_axis_dir;
    float r_lat_sq = dot(lateral_vec, lateral_vec);

    float core_dose = imageLoad(u_core_proton_dose, coord).r;
    float spr = max(imageLoad(u_spr_volume, coord).r, 0.01f);

    // Approximate water-equivalent pathlength scaled by local SPR
    float wet_cm = (depth_mm * spr) * 0.1f;

    // Primary fluence survival fraction due to non-elastic nuclear removal
    float survival = exp(-nuclear_loss_per_cm * wet_cm);

    // Wide nuclear halo envelope growing with depth up to nominal range
    float depth_ratio = clamp(depth_mm / max(nominal_range_mm, 1.0f), 0.0f, 1.15f);
    float sigma_halo = halo_sigma_scale_mm * (0.25f + 0.75f * depth_ratio);
    float halo_kernel = exp(-0.5f * r_lat_sq / max(sigma_halo * sigma_halo, 1.0f));

    // Secondary halo energy builds up smoothly before range cutoff
    float buildup = smoothstep(0.0f, 0.3f, depth_ratio) * (1.0f - smoothstep(0.95f, 1.08f, depth_ratio));
    float halo_dose = core_dose * halo_fraction_weight * buildup * halo_kernel;

    float total_dose = core_dose * survival + halo_dose;

    // Empirical dose-averaged LET (keV/um) model rising sharply toward distal Bragg peak
    float residual_range_mm = max(nominal_range_mm - depth_mm * spr, 0.5f);
    float let_d = 0.5f + 12.0f / pow(residual_range_mm, 0.65f);
    let_d = clamp(let_d, 0.5f, 25.0f);

    imageStore(u_nuclear_dose_output, coord, vec4(total_dose, halo_dose, let_d, 1.0f));
}
