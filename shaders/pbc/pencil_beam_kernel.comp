#version 450 core

/**
 * Kerma Radiation Oncology Simulation Engine
 * 3D Analytical Pencil Beam Convolution (PBC) Compute Shader
 *
 * Evaluates absorbed dose via analytical pencil beam kernel decomposition:
 *   D(x, y, z) = PDD(d_eff) * (SAD / (SAD + z))^2 * [ (1 - w2) * G(r, sigma1) + w2 * G(r, sigma2) ]
 *
 * Implements the Storchi-Woudstra and Mohan double-Gaussian radial
 * scatter model with radiological depth scaling and inverse-square correction.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// 2D collimated fluence map at SAD plane
layout(binding = 0) uniform sampler2D u_collimated_fluence_map;

// 3D radiological depth volume (d_eff in mm)
layout(binding = 1, rgba32f) readonly uniform image3D u_pathlength_volume;

// 3D external contour mask
layout(binding = 2, rgba32f) readonly uniform image3D u_contour_volume;

// Output 3D Pencil Beam absorbed dose grid in Gray (Gy)
layout(binding = 3, rgba32f) writeonly uniform image3D u_pbc_dose_volume;

layout(std140, binding = 4) uniform PBCConfig {
    vec3  source_pos_world_mm;  // Linac focal spot in patient frame
    vec3  grid_origin_mm;       // Voxel (0,0,0) position
    vec3  voxel_spacing_mm;     // Pitch
    ivec4 volume_dimensions;    // (Nx, Ny, Nz, pad)
    mat4  world_to_bev_matrix;  // Transform to BEV at SAD
    float pdd_dmax_mm;          // Depth of maximum dose d_max (e.g. 15.0 mm for 6 MV)
    float pdd_attenuation_alpha;// Exponential falloff beyond d_max (~0.045 cm^-1)
    float sigma1_base_mm;       // Narrow primary electron Gaussian width (~2.5 mm)
    float sigma2_base_mm;       // Broad Compton scatter Gaussian width (~18.0 mm)
    float scatter_weight_w2;    // Relative weight of broad scatter Gaussian (0.12)
    float sad_mm;               // 1000.0 mm
    float dose_normalization;   // Gy / MU calibration gain
};

const float INV_TWO_PI = 0.15915494309;

/**
 * Central axis Percent Depth Dose (PDD) parameterization in water.
 */
float evaluatePDD(float d_eff_mm) {
    if (d_eff_mm <= 0.0) {
        return 0.0;
    }
    // Surface dose buildup up to d_max
    if (d_eff_mm < pdd_dmax_mm) {
        float frac = d_eff_mm / pdd_dmax_mm;
        return 0.45 + 0.55 * sqrt(frac); // Surface dose ~45% for 6 MV
    }
    // Exponential falloff beyond d_max
    float depth_beyond_max_cm = (d_eff_mm - pdd_dmax_mm) * 0.1;
    return exp(-pdd_attenuation_alpha * depth_beyond_max_cm);
}

void main() {
    ivec3 voxel_coord = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(voxel_coord, volume_dimensions.xyz))) {
        return;
    }

    float body_mask = imageLoad(u_contour_volume, voxel_coord).r;
    if (body_mask < 0.5) {
        imageStore(u_pbc_dose_volume, voxel_coord, vec4(0.0));
        return;
    }

    vec3 voxel_pos_mm = grid_origin_mm + (vec3(voxel_coord) + 0.5) * voxel_spacing_mm;

    // Radiological depth and source distance
    vec4 path_data = imageLoad(u_pathlength_volume, voxel_coord);
    float d_eff_mm = path_data.r;
    float dist_to_source_mm = max(1.0, path_data.b);

    // Project into BEV plane at SAD
    vec4 bev_pos = world_to_bev_matrix * vec4(voxel_pos_mm, 1.0);
    float z_from_source = bev_pos.z;
    if (z_from_source <= 10.0) {
        imageStore(u_pbc_dose_volume, voxel_coord, vec4(0.0));
        return;
    }

    float proj_scale = sad_mm / z_from_source;
    vec2 collimator_uv_mm = bev_pos.xy * proj_scale;
    vec2 map_uv = (collimator_uv_mm / 400.0) + vec2(0.5);

    float incident_fluence = 0.0;
    if (all(greaterThanEqual(map_uv, vec2(0.0))) && all(lessThanEqual(map_uv, vec2(1.0)))) {
        incident_fluence = texture(u_collimated_fluence_map, map_uv).r;
    }

    // Inverse square law factor
    float inv_sq = (sad_mm / dist_to_source_mm) * (sad_mm / dist_to_source_mm);

    // Central axis depth dose
    float pdd = evaluatePDD(d_eff_mm);

    // Radial beam divergence broadening of Gaussian scatter kernels:
    // sigma(z) = sigma_base * (1 + 0.002 * d_eff)
    float depth_factor = 1.0 + 0.002 * d_eff_mm;
    float sig1 = sigma1_base_mm * depth_factor;
    float sig2 = sigma2_base_mm * depth_factor;

    // Convolve with collimated field profile:
    // Primary dose inside field aperture scales directly with incident fluence
    float primary_dose = incident_fluence * pdd * inv_sq * dose_normalization;

    imageStore(u_pbc_dose_volume, voxel_coord, vec4(
        primary_dose,
        pdd,
        d_eff_mm,
        incident_fluence
    ));
}
