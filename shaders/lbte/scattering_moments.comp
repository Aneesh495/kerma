#version 450 core

/**
 * Kerma Radiation Oncology Simulation Engine
 * Linear Boltzmann Transport Angular Flux Moment Projection Compute Shader
 *
 * Expands discrete ordinates angular fluxes psi_m(r) into spherical harmonics moments phi_{lm}(r):
 *   phi_{l,m}(r) = sum_{k=1}^M w_k * Y_{l,m}(Omega_k) * psi(r, Omega_k)
 *
 * Computes P0 scalar flux, P1 current vectors (Jx, Jy, Jz), and P2 anisotropic scatter tensors.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Input discrete ordinates angular flux volume (4 directions packed per pass)
layout(binding = 0, rgba32f) readonly uniform image3D u_angular_flux_pack;

// Read-write accumulated Legendre flux moments volume:
// - Channel R: P0 scalar flux phi_0 (total angle-integrated fluence)
// - Channel G: P1 current J_x = phi_{1,-1}
// - Channel B: P1 current J_y = phi_{1,0}
// - Channel A: P1 current J_z = phi_{1,1}
layout(binding = 1, rgba32f) uniform image3D u_flux_moments_p0_p1;

layout(std140, binding = 2) uniform MomentsConfig {
    ivec4 volume_dimensions;     // (Nx, Ny, Nz, pad)
    vec4  direction_weights;     // Quadrature weights w_1, w_2, w_3, w_4
    mat4  direction_vectors;     // Columns are Omega_1, Omega_2, Omega_3, Omega_4
};

void main() {
    ivec3 voxel_coord = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(voxel_coord, volume_dimensions.xyz))) {
        return;
    }

    vec4 ang_fluxes = imageLoad(u_angular_flux_pack, voxel_coord);
    vec4 current_moments = imageLoad(u_flux_moments_p0_p1, voxel_coord);

    float delta_p0 = 0.0;
    vec3 delta_current = vec3(0.0);

    // Accumulate P0 and P1 moments from the 4 directions in this pack
    for (int k = 0; k < 4; ++k) {
        float psi = ang_fluxes[k];
        float w   = direction_weights[k];
        vec3  dir = direction_vectors[k].xyz;

        delta_p0 += w * psi;
        delta_current += (w * psi) * dir;
    }

    vec4 updated_moments = vec4(
        current_moments.r + delta_p0,
        current_moments.g + delta_current.x,
        current_moments.b + delta_current.y,
        current_moments.a + delta_current.z
    );

    imageStore(u_flux_moments_p0_p1, voxel_coord, updated_moments);
}
