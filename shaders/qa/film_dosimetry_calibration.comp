#version 450 core

/**
 * Kerma Radiation Oncology Simulation Engine
 * GPU Multichannel Radiochromic Film Dosimetry Inversion Shader
 *
 * Implements the Micke et al. triple-channel radiochromic (EBT3/EBT-XD) film dosimetry formalism:
 * - Computes optical density per channel: OD_k = -log10(I_k / I0_k) for k in {R, G, B}
 * - Inverts non-linear rational calibration model: D_k = a_k + b_k / (OD_k - c_k)
 * - Decouples true absorbed radiation dose from spatial coating thickness non-uniformities
 * - Computes channel consistency metric and produces filtered 2D absorbed dose map
 */

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// 2D raw scanned transmitted light intensity image (RGB)
layout(binding = 0, rgba32f) readonly uniform image2D u_scanned_film_image;

// 2D unexposed reference background image (RGB)
layout(binding = 1, rgba32f) readonly uniform image2D u_unexposed_background_image;

// Output 2D calibrated dose (R = dose in Gy, G = channel consistency residual, B = thickness delta)
layout(binding = 2, rgba32f) writeonly uniform image2D u_calibrated_dose_image;

layout(std140, binding = 3) uniform FilmCalibrationConfig {
    ivec4 film_dimensions;
    vec4  calib_param_a; // (a_red, a_green, a_blue, 0.0)
    vec4  calib_param_b; // (b_red, b_green, b_blue, 0.0)
    vec4  calib_param_c; // (c_red, c_green, c_blue, 0.0)
    vec4  channel_weights; // Normalized weights (typically red=0.7, green=0.3, blue=0.0)
    float max_allowable_dose_gy;
};

// Invert rational function: D = a + b / (OD - c)
float invert_channel_dose(float od, float a, float b, float c) {
    float denom = od - c;
    if (abs(denom) < 1e-5f) {
        return 0.0f;
    }
    float dose = a + b / denom;
    return max(dose, 0.0f);
}

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= film_dimensions.x || pixel_coord.y >= film_dimensions.y) {
        return;
    }

    vec4 i_raw = imageLoad(u_scanned_film_image, pixel_coord);
    vec4 i_zero = imageLoad(u_unexposed_background_image, pixel_coord);

    // Compute optical densities with numerical safeguards
    const float ln10 = 2.302585092994046f;
    float trans_r = clamp(i_raw.r / max(i_zero.r, 1e-4f), 1e-4f, 1.0f);
    float trans_g = clamp(i_raw.g / max(i_zero.g, 1e-4f), 1e-4f, 1.0f);
    float trans_b = clamp(i_raw.b / max(i_zero.b, 1e-4f), 1e-4f, 1.0f);

    float od_r = -log(trans_r) / ln10;
    float od_g = -log(trans_g) / ln10;
    float od_b = -log(trans_b) / ln10;

    // Independent single-channel dose estimates
    float dose_r = invert_channel_dose(od_r, calib_param_a.r, calib_param_b.r, calib_param_c.r);
    float dose_g = invert_channel_dose(od_g, calib_param_a.g, calib_param_b.g, calib_param_c.g);
    float dose_b = invert_channel_dose(od_b, calib_param_a.b, calib_param_b.b, calib_param_c.b);

    // Multichannel thickness perturbation decoupling:
    // In Micke's method, the three channels provide an overdetermined system.
    // Optimal dose is weighted linear combination:
    float optimal_dose = channel_weights.r * dose_r + 
                         channel_weights.g * dose_g + 
                         channel_weights.b * dose_b;
    optimal_dose = clamp(optimal_dose, 0.0f, max_allowable_dose_gy);

    // Consistency residual: discrepancy between red and green channels
    float residual = abs(dose_r - dose_g);

    // Estimated active layer thickness disturbance ratio Delta
    float thickness_delta = 0.5f * (dose_r / max(optimal_dose, 0.1f) + dose_g / max(optimal_dose, 0.1f)) - 1.0f;

    imageStore(u_calibrated_dose_image, pixel_coord, vec4(optimal_dose, residual, thickness_delta, 1.0f));
}
